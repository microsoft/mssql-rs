      <Item ItemId=";messages[101].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[The {transport} transport did not open ({reason}); without a protocol prefix sqlcmd then tries {next}, checked below.]]></Val>
