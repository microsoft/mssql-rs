      <Item ItemId=";messages[121].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[The dedicated administrator connection to a named instance gets its port from SQL Server Browser's DAC request, which the client does not make, so its endpoint and connection are not checked.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[122].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[The diagnosis could not start its async runtime: {error}.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[123].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[This computer did not let sqlcmd ask SQL Server Browser for the instance's port ({problem}); instance resolution could not be checked.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[124].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[This platform does not expose the resolver's result code; the name-resolution result was classified from the resolver's message.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[125].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[The Kerberos ticket cache could not be looked for within the time limit.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[126].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[The Kerberos ticket cache is a {location} cache, which sqlcmd does not inspect.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[127].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[Only the default file ticket cache was looked for; a KCM or KEYRING cache set in krb5.conf is not inspected.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[128].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[Kerberos encryption types and delegation are not inspected; the SPN is the one the client requests, not proof that it is registered.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[129].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[This computer did not let sqlcmd open a network connection (operating-system error {codes}); network reachability could not be checked.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[12].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[; server certificate trusted (-C)]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[130].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[The connection attempt is made with the mssql-tds client, which reports its pre-login, TLS and login phases; it is not the ODBC driver sqlcmd uses for queries, so TLS and login behavior can differ from a query run.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[131].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[The TLS failure was classified from the error text; no stable error code was available.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
