      <Item ItemId=";messages[89].translation" ItemType="0" PsrId="306" Leaf="true">
        <Str Cat="Text">
          <Val><![CDATA[Without a protocol prefix sqlcmd connects to a local named instance over shared memory first and asks SQL Server Browser only if that fails; this depth opens no connection, so the instance was not looked up. Run the default depth, or use tcp:host\instance to check the SQL Server Browser lookup.]]></Val>
        </Str>
        <Disp Icon="Str" />
      </Item>
      <Item ItemId=";messages[8].translation" ItemType="0" PsrId="306" Leaf="true">
